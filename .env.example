# =====================================================
# Auth DB
# =====================================================
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db

# =====================================================
# Tasks DB
# =====================================================
TASKS_DB_USER=tasks
TASKS_DB_PASSWORD=tasks_pass
TASKS_DB_NAME=tasks_db

# =====================================================
# Auth Service
# =====================================================
# Long random string — generate with: openssl rand -hex 32
JWT_SECRET=2431bf0f7f7a7c77bed028fd4cde73dd071aacea1023d0f29154c88a61b42084

# WebAuthn Relying Party — must match the domain users access the app from
# Dev (Docker):        RP_ID=localhost  RP_ORIGIN=http://localhost
# Dev (Vite):          RP_ID=localhost  RP_ORIGIN=http://localhost:8080
# Prod (Tailscale):    RP_ID=<hostname>.tail<net>.ts.net  RP_ORIGIN=https://<hostname>.tail<net>.ts.net
RP_ID=todo-dev.tailcbe04c.ts.net
RP_ORIGIN=https://todo-dev.tailcbe04c.ts.net

# =====================================================
# Tailscale Funnel
# =====================================================
# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# Use a reusable, non-expiring key for prod. Tag it if using ACL tags.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Tailscale machine hostname (appears in your .ts.net domain)
TS_HOSTNAME=todo-dev

# =====================================================
# Webhook / Deploy Server
# =====================================================
# Must match the secret configured in GitHub repo Settings → Webhooks
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=eddd3e7afd0a74e2e0248f1bd4078ac08bf03dbdaa85092b46e5f615b18c4803

